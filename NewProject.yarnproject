{
    "projectFileVersion": 4,
    "sourceFiles": [
        "**/*.yarn"
    ],
    "excludeFiles": [
        "**/*~/*",
        "./Samples/Yarn Spinner*/*"
    ],
    "localisation": {},
    "baseLanguage": "en",
    "compilerOptions": {
        "diagnosticsSeverity": {}
    },
    "editorOptions": {
        "yarnScriptEditor": {
            "characters": [
                {
                    "name": "Clea",
                    "colour": "#d74798"
                },
                {
                    "name": "You",
                    "colour": "#3da464"
                }
            ]
        }
    }
}